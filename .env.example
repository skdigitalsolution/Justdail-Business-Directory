# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure your local values.
# NEVER commit the actual .env file with sensitive credentials to version control.
# ==============================================================================

# Server / Port Configuration
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000

# Public API URL (consumed by Frontend)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Database Connection (MySQL 8)
# For development with local root user:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=justdials-business

# Prisma Connection URL
# If your password contains special characters, URL-encode them.
DATABASE_URL="mysql://root:your_mysql_password_here@127.0.0.1:3306/justdials-business"
