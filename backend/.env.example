# ==============================================================================
# BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to backend/.env and configure your local development values.
# NEVER commit the actual .env file with sensitive credentials to version control.
# ==============================================================================

NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# Database Configuration (MySQL 8)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=justdials-business

# Prisma Connection URL
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:your_mysql_password_here@127.0.0.1:3306/justdials-business"
